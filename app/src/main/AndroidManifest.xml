<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13+: read videos only -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Android 11-12 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Android 13+: one-tap prompts when a background move or delete needs the user -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 12+: lets the user grant "Media management" so moves and trash run without a dialog -->
    <uses-permission
        android:name="android.permission.MANAGE_MEDIA"
        tools:ignore="ProtectedPermissions" />
    <!-- Media management only skips the confirmation dialog for apps that also hold this -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- All files access and the battery-exemption request are in src/full: Google Play does not
         allow them for this kind of app. -->

    <!-- Android 14+ hides which app saved a video (OWNER_PACKAGE_NAME) from apps targeting 34+,
         unless that app is visible to us. Keep in sync with TikTokDetector's package lists. -->
    <queries>
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.ss.android.ugc.trill" />
        <package android:name="com.zhiliaoapp.musically.go" />
        <package android:name="com.ss.android.ugc.tiktok.lite" />
        <package android:name="com.google.android.GoogleCamera" />
        <package android:name="com.sec.android.app.camera" />
        <package android:name="com.android.camera" />
        <package android:name="com.android.camera2" />
        <package android:name="com.oneplus.camera" />
        <package android:name="com.oplus.camera" />
        <package android:name="com.motorola.camera3" />
        <package android:name="com.huawei.camera" />
    </queries>

    <application
        android:name=".SharedClipsApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SharedClips">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".CleanupActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection|keyboard|keyboardHidden|navigation"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.SharedClips.Translucent" />
        <!-- Told when the user swipes away the move notification -->
        <receiver
            android:name=".work.MovePromptDismissed"
            android:exported="false" />
    </application>
</manifest>
