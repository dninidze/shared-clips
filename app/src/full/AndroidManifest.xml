<?xml version="1.0" encoding="utf-8"?>
<!-- Permissions only the sideloaded build asks for. Google Play does not allow either for this kind
     of app, so the Play build leaves them out. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lets the user exempt the app from battery optimization, so Android does not hold back the
         automatic jobs of an app that is rarely opened. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Optional "All files access": the only way a background job can move or trash another app's
         videos without a tap. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
</manifest>
